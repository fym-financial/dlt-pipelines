[destination.postgres.credentials]
database = "dlt_data"
username = "loader"
password = "replace-me"
host = "localhost"
port = 5432
connect_timeout = 15

[sources.heartland_api]
username = "FYMUser"
password = "replace-me"
base_url = "https://api.hnlicagent.com"

# Optional local fallback only. Prefer Infisical environment variables.
[sftp_providers.unl.sftp]
bucket_url = "sftp://sftp.example.com/inbound"
file_globs = ["*.csv", "CommissionStatements/*.csv"]
username = "replace-me"
password = "replace-me"
# port = 22
# key_filename = "/path/to/private/key"
# key_passphrase = "replace-me"

[sftp_providers.unl.s3.landing]
bucket_url = "s3://my-landing-bucket/raw"
prefix = "unl/inbound"

[s3.credentials]
aws_access_key_id = "replace-me"
aws_secret_access_key = "replace-me"
region_name = "us-west-004"
endpoint_url = "https://s3.us-west-004.backblazeb2.com"
